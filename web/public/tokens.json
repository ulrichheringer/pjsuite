{
  "name": "PJ Suite",
  "version": "1.0.0",
  "mode": "light",
  "colors": {
    "primary": "#263D52",
    "primary-hover": "#1C3042",
    "background": "#F7F8FA",
    "surface": "#FFFFFF",
    "text": "#202C36",
    "text-muted": "#5C6875",
    "border": "#D8DEE5",
    "input-border": "#B2BECA",
    "focus": "#537895",
    "accent": "#995033",
    "success": "#28654B",
    "success-bg": "#E7F2EB",
    "warning": "#815B16",
    "warning-bg": "#F8EED8",
    "error": "#A13842",
    "error-bg": "#F8E9EB",
    "info": "#355D82",
    "info-bg": "#E8EFF7"
  },
  "typography": {
    "display": {
      "family": "DM Serif Display",
      "weight": 400,
      "sizes": [60, 48, 38, 32],
      "lineHeight": 1.12
    },
    "ui": {
      "family": "Manrope",
      "weights": [400, 500, 600, 700],
      "sizes": [18, 16, 14, 12],
      "lineHeight": 1.6
    }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": {
    "badge": 4,
    "control": 8,
    "card": 12,
    "feature": 20
  },
  "border": "1px solid #D8DEE5",
  "shadow": {
    "overlay": "0 16px 48px #263D521A"
  },
  "focus": {
    "width": 3,
    "offset": 3,
    "color": "#537895"
  },
  "motion": {
    "durationMs": 160,
    "easing": "ease",
    "reducedMotion": true
  },
  "layout": {
    "sidebar": 224,
    "proMax": 1400,
    "clientMax": 1120,
    "mobileBreakpoint": 768,
    "tabletBreakpoint": 1024,
    "mobileMargin": 20,
    "desktopMargin": 40,
    "minTouchTarget": 44
  }
}
