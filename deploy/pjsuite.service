[Unit]
Description=PJ Suite
After=network-online.target
Wants=network-online.target

[Service]
User=pjsuite
Group=pjsuite
EnvironmentFile=/etc/pjsuite/pjsuite.env
ExecStart=/opt/pjsuite/pjsuite
StateDirectory=pjsuite
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
