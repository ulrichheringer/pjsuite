[Unit]
Description=Litestream replication for PJ Suite
After=pjsuite.service
Requires=pjsuite.service

[Service]
User=pjsuite
Group=pjsuite
EnvironmentFile=/etc/pjsuite/pjsuite.env
ExecStart=/usr/local/bin/litestream replicate -config /etc/pjsuite/litestream.yml
StateDirectory=pjsuite
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
